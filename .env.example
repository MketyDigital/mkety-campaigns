NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://mkety_campaigns:change-me@localhost:5432/mkety_campaigns

# Primary object storage: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mkety-campaigns

# Backup target: OCI Object Storage S3 Compatibility API. OCI buckets default
# to Standard; configure a lifecycle rule to move backup objects to Infrequent
# Access after the desired age. Infrequent Access is not a bucket default tier.
OCI_OBJECT_STORAGE_ENDPOINT=
OCI_OBJECT_STORAGE_REGION=
OCI_OBJECT_STORAGE_ACCESS_KEY_ID=
OCI_OBJECT_STORAGE_SECRET_ACCESS_KEY=
OCI_OBJECT_STORAGE_BUCKET=

# Independent backup target: Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=mkety-campaigns-backup

# Cloudflare Worker deployment only. D1 is optional and not used by Coolify.
# Set this binding in wrangler.jsonc before deploying the Worker target.
