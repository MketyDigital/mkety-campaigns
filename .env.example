NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://mkety_campaigns:change-me@localhost:5432/mkety_campaigns
# Production maps DATABASE_URL to the existing MKETY_DATABASE_URL and uses this isolated schema.
CAMPAIGNS_DB_SCHEMA=campaigns

# Primary object storage: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mkety-campaigns

# Optional OCI backup target: S3-compatible. It remains disabled by default,
# even if these credentials exist. When explicitly enabled, uploads use object-
# level Infrequent Access; retain each object for at least 31 days.
OCI_BACKUP_ENABLED=false
OCI_BACKUP_RETENTION_DAYS=90
OCI_OBJECT_STORAGE_ENDPOINT=
OCI_OBJECT_STORAGE_REGION=
OCI_OBJECT_STORAGE_ACCESS_KEY_ID=
OCI_OBJECT_STORAGE_SECRET_ACCESS_KEY=
OCI_OBJECT_STORAGE_BUCKET=

# Independent backup target: Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=mkety-campaigns-backup

# Select one active campaign email adapter for this deployment.
# Supported: acs-email, oci-email-delivery.
EMAIL_PROVIDER=acs-email
# Azure Communication Services Email data-plane credential.
ACS_EMAIL_CONNECTION_STRING=
# Test sends are off by default. When enabled, the test-send
# endpoint can send one fixed email only to the authenticated account's address.
EMAIL_TEST_SEND_ENABLED=false
EMAIL_CAMPAIGN_SEND_ENABLED=false
EMAIL_CAMPAIGN_MAX_RECIPIENTS=100
# Total newly queued recipient jobs per tenant per UTC day (counts reserved jobs even if later suppressed).
EMAIL_CAMPAIGN_DAILY_RECIPIENT_LIMIT=1000
# Minimum milliseconds between claims per provider across all Node replicas (250–60000).
EMAIL_PROVIDER_MIN_INTERVAL_MS=1000

# SMS is provider-neutral; no SMS provider is active by default.
# Initial adapter candidate: Telnyx, subject to destination-country review.
SMS_ENABLED=false
SMS_PROVIDER=
TELNYX_API_KEY=

# Azure Resource Manager identity for ACS domain provisioning. Used when
# EMAIL_PROVIDER=acs-email. Scope its custom role to Email and Communication resources.
AZURE_ARM_TENANT_ID=
AZURE_ARM_CLIENT_ID=
AZURE_ARM_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=mkety_group
AZURE_EMAIL_SERVICE_NAME=MketyEmailMarket2
AZURE_COMMUNICATION_SERVICE_NAME=mketycomm2

# OCI Email Delivery (signing key is also used to provision tenant domains and
# approved senders). Set EMAIL_PROVIDER=oci-email-delivery to select it.
OCI_EMAIL_ENDPOINT=
OCI_EMAIL_REGION=
OCI_EMAIL_TENANCY_OCID=
OCI_EMAIL_USER_OCID=
OCI_EMAIL_FINGERPRINT=
OCI_EMAIL_PRIVATE_KEY=
OCI_EMAIL_COMPARTMENT_OCID=

# Customer authentication runtime; set in Coolify secrets.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# MKETY Auth (OIDC) for Campaigns Ops. Use an application-specific public PKCE client.
# Register https://campaign.mkety.com/api/ops/auth/callback as its redirect URI.
MKETY_OPS_AUTH_ISSUER=
MKETY_OPS_AUTH_CLIENT_ID=
MKETY_OPS_ALLOWED_EMAIL=
MKETY_OPS_AUTH_CALLBACK_URL=https://campaign.mkety.com/api/ops/auth/callback

# Cloudflare Worker deployment only. D1 is optional and not used by Coolify.
# Set this binding in wrangler.jsonc before deploying the Worker target.
